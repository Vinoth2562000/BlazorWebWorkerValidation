            "text": "/* /Layout/MainLayout.razor.rz.scp.css */\r\n.page[b-y7gam33hrn] {\r\n    position: relative;\r\n    display: flex;\r\n    flex-direction: column;\r\n}\r\n\r\nmain[b-y7gam33hrn] {\r\n    flex: 1;\r\n}\r\n\r\n.sidebar[b-y7gam33hrn] {\r\n    background-image: linear-gradient(180deg, rgb(5, 39, 103) 0%, #3a0647 70%);\r\n}\r\n\r\n.top-row[b-y7gam33hrn] {\r\n    background-color: #f7f7f7;\r\n    border-bottom: 1px solid #d6d5d5;\r\n    justify-content: flex-end;\r\n    height: 3.5rem;\r\n    display: flex;\r\n    align-items: center;\r\n}\r\n\r\n    .top-row[b-y7gam33hrn]  a, .top-row[b-y7gam33hrn]  .btn-link {\r\n        white-space: nowrap;\r\n        margin-left: 1.5rem;\r\n        text-decoration: none;\r\n    }\r\n\r\n    .top-row[b-y7gam33hrn]  a:hover, .top-row[b-y7gam33hrn]  .btn-link:hover {\r\n        text-decoration: underline;\r\n    }\r\n\r\n    .top-row[b-y7gam33hrn]  a:first-child {\r\n        overflow: hidden;\r\n        text-overflow: ellipsis;\r\n    }\r\n\r\n@media (max-width: 640.98px) {\r\n    .top-row[b-y7gam33hrn] {\r\n        justify-content: space-between;\r\n    }\r\n\r\n    .top-row[b-y7gam33hrn]  a, .top-row[b-y7gam33hrn]  .btn-link {\r\n        margin-left: 0;\r\n    }\r\n}\r\n\r\n@media (min-width: 641px) {\r\n    .page[b-y7gam33hrn] {\r\n        flex-direction: row;\r\n    }\r\n\r\n    .sidebar[b-y7gam33hrn] {\r\n        width: 250px;\r\n        height: 100vh;\r\n        position: sticky;\r\n        top: 0;\r\n    }\r\n\r\n    .top-row[b-y7gam33hrn] {\r\n        position: sticky;\r\n        top: 0;\r\n        z-index: 1;\r\n    }\r\n\r\n    .top-row.auth[b-y7gam33hrn]  a:first-child {\r\n        flex: 1;\r\n        text-align: right;\r\n        width: 0;\r\n    }\r\n\r\n    .top-row[b-y7gam33hrn], article[b-y7gam33hrn] {\r\n        padding-left: 2rem !important;\r\n        padding-right: 1.5rem !important;\r\n    }\r\n}\r\n/* /Layout/NavMenu.razor.rz.scp.css */\r\n.navbar-toggler[b-oj8pu0brk7] {\r\n    background-color: